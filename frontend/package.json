{
  "name": "course-k-blog-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:runtime": "node --test runtime.test.mjs",
    "test:ui": "rsbuild build --config ui-test.config.ts && playwright test --config ui-playwright.config.ts",
    "test:ssr": "node --test ui-tests/ssr.test.mjs",
    "test:ogp": "node --test ogp.test.mjs",
    "check": "npm run build && npm run typecheck && npm run typecheck:tests && npm run test:runtime && npm run test:api && npm run test:ssr && npm run test:ogp",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "test:api": "node --experimental-strip-types --test src/features/editor/adminApi.test.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "srvx": "1.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.2.13",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
