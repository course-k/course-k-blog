{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW DRAFT ONLY. No AWS deployment performed. See docs/aws-deployment-review.md blockers before use.",
  "Parameters": {
    "EnableRuntime": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Keep false until application prerequisites and charges are approved."
    },
    "PostgresVersion": {
      "Type": "String",
      "Description": "Explicit currently supported Tokyo PostgreSQL version; verify before deployment."
    },
    "PublicOrigin": {
      "Type": "String",
      "Default": "",
      "Description": "HTTPS origin with no trailing slash; empty uses generated API endpoint."
    },
    "NodeImage": {
      "Type": "String",
      "Default": "",
      "Description": "ECR image pinned by digest; required before runtime activation."
    },
    "GoImage": {
      "Type": "String",
      "Default": "",
      "Description": "ECR image pinned by digest; required before runtime activation."
    },
    "DatabaseUrlParameterArn": {
      "Type": "String",
      "Description": "Existing SSM SecureString ARN under the AWS-managed SSM key; contains no value here.",
      "AllowedPattern": "arn:aws:ssm:ap-northeast-1:[0-9]{12}:parameter/.+"
    },
    "AdminHashParameterArn": {
      "Type": "String",
      "Description": "Existing SSM SecureString ARN under the AWS-managed SSM key; contains no value here.",
      "AllowedPattern": "arn:aws:ssm:ap-northeast-1:[0-9]{12}:parameter/.+"
    }
  },
  "Conditions": {
    "RunApplication": {
      "Fn::Equals": [
        {
          "Ref": "EnableRuntime"
        },
        "true"
      ]
    },
    "CustomOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PublicOrigin"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true
      }
    },
    "Igw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "AttachIgw": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Igw"
        }
      },
      "DependsOn": "AttachIgw"
    },
    "Public1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public1Routes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public1"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "Private1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public2Routes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public2"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "Private2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "LinkSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Link network boundary; ingress explicitly listed",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "NodeSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Node network boundary; ingress explicitly listed",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "GoSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Go network boundary; ingress explicitly listed",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "DbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Db network boundary; ingress explicitly listed",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "LinkToNode": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "LinkSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000
      }
    },
    "LinkToGo": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "GoSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "LinkSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 8081,
        "ToPort": 8081
      }
    },
    "NodeToGo": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "GoSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "NodeSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 8081,
        "ToPort": 8081
      }
    },
    "GoToDb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DbSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "GoSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private database subnets",
        "SubnetIds": [
          {
            "Ref": "Private1"
          },
          {
            "Ref": "Private2"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "PostgresVersion"
        },
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "DBName": "blog",
        "MasterUsername": "blogowner",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSg"
          }
        ],
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "ImagesBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ImagesBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ImagesBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ImagesBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ImagesBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "BackupsBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BackupsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupsBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupsBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupsBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "NodeRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "NodeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "GoRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "GoLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "GatewayLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "Namespace": {
      "Type": "AWS::ServiceDiscovery::PrivateDnsNamespace",
      "Properties": {
        "Name": "blog.internal",
        "Vpc": {
          "Ref": "Vpc"
        }
      }
    },
    "NodeDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "web",
        "NamespaceId": {
          "Ref": "Namespace"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            },
            {
              "Type": "SRV",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "GoDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "api",
        "NamespaceId": {
          "Ref": "Namespace"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            },
            {
              "Type": "SRV",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "VpcLink": {
      "Type": "AWS::ApiGatewayV2::VpcLink",
      "Properties": {
        "Name": "blog-link",
        "SubnetIds": [
          {
            "Ref": "Private1"
          },
          {
            "Ref": "Private2"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "LinkSg"
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "course-k-blog-validation",
        "ProtocolType": "HTTP"
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "GatewayLogs",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"status\":\"$context.status\",\"route\":\"$context.routeKey\",\"integrationError\":\"$context.integrationErrorMessage\"}"
        }
      }
    },
    "NodeExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "NodeRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "NodeLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "RunApplication"
    },
    "NodeTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      },
      "Condition": "RunApplication"
    },
    "NodeTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-node"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "NodeExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "NodeTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "node",
            "Image": {
              "Ref": "NodeImage"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "PORT",
                "Value": "3000"
              },
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "API_BASE_URL",
                "Value": "http://api.blog.internal:8081"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "NodeLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "node"
              }
            }
          }
        ]
      },
      "Condition": "RunApplication"
    },
    "NodeService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": 1,
        "TaskDefinition": {
          "Ref": "NodeTask"
        },
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "Public1"
              },
              {
                "Ref": "Public2"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "NodeSg"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "NodeDiscovery",
                "Arn"
              ]
            },
            "ContainerName": "node",
            "ContainerPort": 3000
          }
        ]
      },
      "Condition": "RunApplication",
      "DependsOn": "InternetRoute"
    },
    "NodeIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "ConnectionId": {
          "Ref": "VpcLink"
        },
        "ConnectionType": "VPC_LINK",
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "NodeDiscovery",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 30000,
        "RequestParameters": {
          "overwrite:path": "$request.path"
        }
      },
      "Condition": "RunApplication"
    },
    "GoExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "GoRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "GoLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters"
                  ],
                  "Resource": [
                    {
                      "Ref": "DatabaseUrlParameterArn"
                    },
                    {
                      "Ref": "AdminHashParameterArn"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Condition": "RunApplication"
    },
    "GoTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      },
      "Condition": "RunApplication"
    },
    "GoTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-go"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "GoExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "GoTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "go",
            "Image": {
              "Ref": "GoImage"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8081,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "LISTEN_ADDR",
                "Value": "0.0.0.0:8081"
              },
              {
                "Name": "APP_ORIGIN",
                "Value": {
                  "Fn::If": [
                    "CustomOrigin",
                    {
                      "Ref": "PublicOrigin"
                    },
                    {
                      "Fn::GetAtt": [
                        "HttpApi",
                        "ApiEndpoint"
                      ]
                    }
                  ]
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "GoLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "go"
              }
            },
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Ref": "DatabaseUrlParameterArn"
                }
              },
              {
                "Name": "ADMIN_PASSWORD_HASH",
                "ValueFrom": {
                  "Ref": "AdminHashParameterArn"
                }
              }
            ]
          }
        ]
      },
      "Condition": "RunApplication"
    },
    "GoService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": 1,
        "TaskDefinition": {
          "Ref": "GoTask"
        },
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "Public1"
              },
              {
                "Ref": "Public2"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "GoSg"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "GoDiscovery",
                "Arn"
              ]
            },
            "ContainerName": "go",
            "ContainerPort": 8081
          }
        ]
      },
      "Condition": "RunApplication",
      "DependsOn": "InternetRoute"
    },
    "GoIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "ConnectionId": {
          "Ref": "VpcLink"
        },
        "ConnectionType": "VPC_LINK",
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "GoDiscovery",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 30000,
        "RequestParameters": {
          "overwrite:path": "$request.path"
        }
      },
      "Condition": "RunApplication"
    },
    "ApiRoot": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "GoIntegration"
              }
            ]
          ]
        }
      },
      "Condition": "RunApplication"
    },
    "ApiChildren": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api/{proxy+}",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "GoIntegration"
              }
            ]
          ]
        }
      },
      "Condition": "RunApplication"
    },
    "Screens": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "NodeIntegration"
              }
            ]
          ]
        }
      },
      "Condition": "RunApplication"
    },
    "NodeCPUUtilizationAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "RunApplication",
      "Properties": {
        "Namespace": "AWS/ECS",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "ClusterName",
            "Value": {
              "Ref": "Cluster"
            }
          },
          {
            "Name": "ServiceName",
            "Value": {
              "Fn::GetAtt": [
                "NodeService",
                "Name"
              ]
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "NodeMemoryUtilizationAlarm": {
