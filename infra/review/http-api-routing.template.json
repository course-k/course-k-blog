{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW ONLY: routing slice, not a complete or approved deployment. Requires existing VPC Link and ECS-managed Cloud Map services.",
  "Parameters": {
    "VpcLinkId": {
      "Type": "String"
    },
    "NodeCloudMapServiceArn": {
      "Type": "String"
    },
    "GoCloudMapServiceArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "course-k-blog-routing-validation",
        "ProtocolType": "HTTP"
      }
    },
    "NodeIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "ConnectionId": {
          "Ref": "VpcLinkId"
        },
        "ConnectionType": "VPC_LINK",
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Ref": "NodeCloudMapServiceArn"
        },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 30000,
        "RequestParameters": {
          "overwrite:path": "$request.path"
        }
      }
    },
    "GoIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "ConnectionId": {
          "Ref": "VpcLinkId"
        },
        "ConnectionType": "VPC_LINK",
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Ref": "GoCloudMapServiceArn"
        },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 30000,
        "RequestParameters": {
          "overwrite:path": "$request.path"
        }
      }
    },
    "ApiRoot": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "GoIntegration"
              }
            ]
          ]
        }
      }
    },
    "ApiChildren": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api/{proxy+}",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "GoIntegration"
              }
            ]
          ]
        }
      }
    },
    "ScreenDefault": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "NodeIntegration"
              }
            ]
          ]
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true
      }
    }
  },
  "Outputs": {
    "Endpoint": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    }
  }
}
